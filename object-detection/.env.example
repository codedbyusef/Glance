# Copy to object-detection/.env (gitignored) and fill in once the Vultr instance exists.

# Public IPv4 of the Vultr GPU instance (Vultr dashboard -> instance -> Overview).
GLANCE_VULTR_HOST=

# SSH key for the instance, if not your default (~/.ssh/id_ed25519 etc).
# GLANCE_SSH_KEY=~/.ssh/vultr_glance

# Only needed if port 8000 is opened to the internet instead of using the SSH tunnel.
# GLANCE_TOKEN=

# Point the client somewhere else entirely (overrides the vultr settings in config.yaml).
# GLANCE_VISION_URL=ws://localhost:8000/ws
